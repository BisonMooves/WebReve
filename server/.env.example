# MongoDB Atlas Connection URL
MONGO_URL=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/WebReve_DB?retryWrites=true&w=majority

# MongoDB Database Name
DB_NAME=WebReve_DB

# JWT Secret for Admin Authentication
JWT_SECRET=your_secure_jwt_secret_here

# Server Port
PORT=5001

# Resend API Key (Optional)
RESEND_API_KEY=
